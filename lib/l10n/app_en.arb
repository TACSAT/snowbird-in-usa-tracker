  "referenceTitle": "Common day-count rules",
  "@referenceTitle": { "description": "Reference screen title (FR-15)." },

  "referenceIntro": "These are numbers people commonly track. {appName} sets none of them for you — you enter your own in Alerts. This page is background information, not advice: verify your own situation with a qualified professional.",
