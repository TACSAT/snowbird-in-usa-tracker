  "aboutPrivacyTitle": "Your privacy",
  "@aboutPrivacyTitle": { "description": "About screen: privacy section heading." },

  "aboutPrivacyBody": "SnowBird has no account, no cloud, and no tracking. Everything you enter stays on this device and is never sent to the developer. Your data is included in your phone's normal backup (iCloud or Google), so it moves to a new phone with you.",
  "@aboutPrivacyBody": { "description": "About screen: privacy statement." },

