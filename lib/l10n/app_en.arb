  "referenceTitle": "Common day-count rules",
  "@referenceTitle": { "description": "Reference screen title (FR-15)." },

  "referenceIntro": "These are numbers people commonly track. SnowBird sets none of them for you — you enter your own in Alerts. This page is background information, not advice: verify your own situation with a qualified professional.",
  "@referenceIntro": { "description": "Reference screen intro; restates the no-defaults, not-advice stance." },

  "referenceSptTitle": "US Substantial Presence Test",
  "@referenceSptTitle": { "description": "Reference item heading: IRS SPT." },

  "referenceSptBody": "A US tax residency test based on a weighted count over three years: all your days this year, plus one third of last year, plus one sixth of the year before. SnowBird shows this figure as a neutral number.",
  "@referenceSptBody": { "description": "Reference item: neutral SPT description." },

  "referenceHealthTitle": "Provincial health coverage",
  "@referenceHealthTitle": { "description": "Reference item heading: provincial health." },

  "referenceHealthBody": "Many provincial health plans expect you to be physically present in your province for a minimum number of days each year. The exact number varies by province and changes over time — check your own plan's current rule.",
  "@referenceHealthBody": { "description": "Reference item: provincial health, no specific number asserted." },

  "referenceEntryTitle": "Length of a US visit",
  "@referenceEntryTitle": { "description": "Reference item heading: per-entry admission." },

  "referenceEntryBody": "A visitor is generally admitted for a limited period per entry, at the border officer's discretion. The admitted-until date is on your I-94 record — and land crossings are not always recorded, which is exactly why keeping your own dates matters.",
  "@referenceEntryBody": { "description": "Reference item: per-entry admission + I-94 gap." },

  "referenceMythTitle": "There is no single cumulative limit",
  "@referenceMythTitle": { "description": "Reference item heading: the 180-day myth." },

  "referenceMythBody": "There is no one cumulative 'days' limit this app could enforce for you. Immigration lawyers often call the '180-day rule' a myth; the real constraints are the per-entry admission, the officer's discretion, and separate tax tests. That is why SnowBird counts and never judges.",
  "@referenceMythBody": { "description": "Reference item: why the app never renders a verdict." },

