<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- EN: Notification permissions for USER-CREATED alerts only (PLAN.md).
             POST_NOTIFICATIONS is the Android 13+ runtime permission, requested
             in-app only when the user saves their first alert.
             RECEIVE_BOOT_COMPLETED lets scheduled notifications survive a
             reboot. Deliberately ABSENT: INTERNET (the app makes zero network
             calls), location, and SCHEDULE_EXACT_ALARM (inexact delivery is
             enough for a day-count notice — fewer permissions by design).
         FR: Permissions de notification pour les alertes CRÉÉES PAR
             L'UTILISATEUR uniquement (PLAN.md). POST_NOTIFICATIONS est la
             permission d'exécution d'Android 13+, demandée dans l'appli
             seulement quand l'utilisateur enregistre sa première alerte.
             RECEIVE_BOOT_COMPLETED permet aux notifications planifiées de
             survivre à un redémarrage. Délibérément ABSENTES : INTERNET
             (l'appli ne fait aucun appel réseau), la localisation et
             SCHEDULE_EXACT_ALARM (une livraison inexacte suffit pour un avis
             de compte de jours — moins de permissions, par conception). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- EN: The optional app lock (WRK-11) asks the phone's own face,
             fingerprint or code check. No network: still no INTERNET.
         FR: Le verrouillage facultatif (WRK-11) demande la vérification
             du téléphone (visage, empreinte ou code). Aucun réseau :
             toujours pas d'INTERNET. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- EN: allowBackup="true" is Android's default, but we set it EXPLICITLY
             because it is a product requirement (PLAN.md FR-11), not an accident:
             the app ships no bespoke backup feature, so the user's trip data must
             ride Android's own Auto Backup to survive a phone migration. Making it
             explicit also guards against a future manifest-template change silently
             flipping it off. No data leaves the device for the DEVELOPER — this is
             the user's own Google backup (NFR-1).
         FR: allowBackup="true" est la valeur par défaut d'Android, mais nous la
             fixons EXPLICITEMENT car c'est une exigence du produit (PLAN.md FR-11),
             pas un hasard : l'appli ne livre aucune fonction de sauvegarde dédiée,
             donc les données de séjour de l'utilisateur doivent voyager dans la
             sauvegarde automatique d'Android pour survivre à une migration de
             téléphone. L'expliciter protège aussi contre un futur changement de
             gabarit de manifeste qui la désactiverait en silence. Aucune donnée ne
             quitte l'appareil vers le DÉVELOPPEUR — c'est la sauvegarde Google de
             l'utilisateur (NFR-1). -->
    <application
        android:label="SENALOVIRA"
        android:name="${applicationName}"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- EN: flutter_local_notifications receivers — deliver scheduled
                 notifications and re-register them after a reboot or app
                 update. Both are exported="false": nothing outside this app
                 can trigger them.
             FR: Récepteurs de flutter_local_notifications — livrent les
                 notifications planifiées et les réinscrivent après un
                 redémarrage ou une mise à jour. Les deux sont
                 exported="false" : rien d'extérieur à l'appli ne peut les
                 déclencher. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
